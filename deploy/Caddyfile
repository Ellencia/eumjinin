# HTTPS 자동(Let's Encrypt). DNS가 이 서버를 가리키기 전엔 인증서 발급이 실패하고 재시도만 함
kband.co.kr {
	encode gzip
	# HSTS는 includeSubDomains 없이(하위 도메인은 아직 안 씀). 프레임 금지 = /admin 클릭재킹 방지
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy localhost:8703
}

www.kband.co.kr {
	redir https://kband.co.kr{uri} permanent
}

# IP로 들어오면 도메인 HTTPS로. 예전엔 사이트 전체(신청 폼 포함)를 평문 http로 열어 두었음
http://158.247.204.136 {
	redir https://kband.co.kr{uri} permanent
}
